rules_version = '2';
// Who may read and write what in the Paperloop database (Firestore). Publish these in the Firebase console
// (Firestore Database → Rules → paste → Publish) or with `firebase deploy --only firestore:rules`.
// The Paperloop team is the `team` collection: one record per person, kept under their Google email, with
// role owner | ops | sales and active true. The first owner record is added once in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function myRecord() { return get(/databases/$(database)/documents/team/$(myEmail())).data; }
    function onTeam() {
      return signedIn() && exists(/databases/$(database)/documents/team/$(myEmail())) && myRecord().get('active', false) == true;
    }
    function hasRole(roles) { return onTeam() && myRecord().role in roles; }
    function anyRole() { return hasRole(['owner', 'ops', 'sales']); }
    function canDelete() { return hasRole(['owner', 'ops']); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // The team: everyone on it sees it; only the owner adds, changes or removes people.
    // A person may read their own record (to find out whether they are on the team).
    // The owner cannot remove themself or take away their own owner role.
    match /team/{email} {
      allow get: if signedIn() && email == myEmail();
      allow read: if onTeam();
      allow create: if hasRole(['owner']) && email == email.lower()
        && request.resource.data.role in ['owner', 'ops', 'sales'] && str(request.resource.data.name, 1, 60);
      allow update: if hasRole(['owner']) && request.resource.data.role in ['owner', 'ops', 'sales']
        && (email != myEmail() || (request.resource.data.role == 'owner' && request.resource.data.get('active', true) == true));
      allow delete: if hasRole(['owner']) && email != myEmail();
    }

    // Enquiries & orders: the whole team works on them. Anyone (a landing page visitor) may send a new one,
    // and only in the exact shape the landing page sends; visitors cannot read, change or delete any.
    match /leads/{id} {
      allow read, update: if anyRole();
      allow create: if anyRole() || (
        request.resource.data.keys().hasOnly(['created', 'kind', 'status', 'source', 'page', 'summary', 'name', 'phone', 'org', 'upazila', 'message', 'owner', 'notes'])
        && request.resource.data.keys().hasAll(['created', 'kind', 'status', 'source', 'page', 'name', 'phone'])
        && request.resource.data.status == 'new' && request.resource.data.source == 'Landing page'
        && request.resource.data.owner == '' && request.resource.data.notes == []
        && request.resource.data.kind in ['diary', 'khata', 'a4', 'ring']
        && request.resource.data.created is int
        && str(request.resource.data.page, 1, 40) && str(request.resource.data.name, 1, 60) && str(request.resource.data.phone, 8, 20)
        && str(request.resource.data.get('summary', ''), 0, 120) && str(request.resource.data.get('org', ''), 0, 80)
        && str(request.resource.data.get('upazila', ''), 0, 40) && str(request.resource.data.get('message', ''), 0, 400));
      allow delete: if canDelete();
    }

    // Institutions: the whole team; deleting is for the owner and operations
    match /institutions/{id} {
      allow read, create, update: if anyRole();
      allow delete: if canDelete();
    }

    // Landing pages: anyone may read a published (live) page and add one visit to it; the team edits them
    match /pages/{id} {
      allow read: if anyRole() || resource.data.status == 'live';
      allow create: if anyRole();
      allow update: if anyRole() || (resource.data.status == 'live'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.get('views', 0) + 1);
      allow delete: if canDelete();
    }

    // Support: the owner and operations
    match /tickets/{id} {
      allow read, create, update, delete: if hasRole(['owner', 'ops']);
    }

    // The common standard and topics: the team reads them; the owner and operations change them
    match /settings/{id} {
      allow read: if anyRole();
      allow write: if hasRole(['owner', 'ops']);
    }

    // ---------- The smart diary (real schools) ----------
    // members/{google email}: who may open which school's diary, as principal or teacher. Paperloop Admin adds
    // each principal; a principal adds and removes the teachers of their own school only.
    function memberDoc() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    function me() { return get(memberDoc()).data; }
    function schoolOpen(code) { return get(/databases/$(database)/documents/schools/$(code)).data.get('active', false) == true; }
    function staffOf(code) { return isMember() && me().code == code && schoolOpen(code); }
    function principalOf(code) { return staffOf(code) && me().role == 'principal'; }

    // Parents: one sign-in account per child (school code + class + roll + PIN). parents/{account} says which
    // child; parentLogins/{CODE_classcode_roll} lets the login page find the account (it holds no PIN).
    // The school's principal makes and replaces them.
    function parentDoc() { return /databases/$(database)/documents/parents/$(request.auth.uid); }
    function isParent() { return request.auth != null && exists(parentDoc()); }
    function kid() { return get(parentDoc()).data; }
    function parentIn(code) { return isParent() && kid().code == code && schoolOpen(code); }

    match /parents/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if principalOf(request.resource.data.code) && request.resource.data.keys().hasOnly(['code', 'cls', 'roll', 'sid'])
        && request.resource.data.roll is int && str(request.resource.data.sid, 3, 30);
      allow delete: if principalOf(resource.data.code);
    }
    match /parentLogins/{id} {
      allow get: if true;
      allow create, update: if principalOf(request.resource.data.code) && id.matches(request.resource.data.code + '_[0-9]+_[0-9]+')
        && request.resource.data.keys().hasOnly(['code', 'email', 'sid', 'uid']);
      allow delete: if principalOf(resource.data.code);
    }

    match /members/{email} {
      allow get: if signedIn() && email == myEmail();
      allow read: if anyRole() || (isMember() && me().role == 'principal' && resource.data.code == me().code);
      allow create: if anyRole() || (principalOf(request.resource.data.code) && request.resource.data.role == 'teacher'
        && email == email.lower() && request.resource.data.keys().hasOnly(['code', 'role', 'name']) && str(request.resource.data.name, 1, 60));
      allow update: if anyRole() || (principalOf(resource.data.code) && resource.data.role == 'teacher'
        && request.resource.data.code == resource.data.code && request.resource.data.role == 'teacher'
        && request.resource.data.keys().hasOnly(['code', 'role', 'name']) && str(request.resource.data.name, 1, 60));
      allow delete: if anyRole() || (principalOf(resource.data.code) && resource.data.role == 'teacher');
    }

    // schools/{CODE}: set up by Paperloop Admin (name, principal, active). Its diary is in schools/{CODE}/state/{part}:
    // the school's principal and teachers read it; the principal changes every part, teachers the parts of their
    // daily work.
    match /schools/{code} {
      allow read: if anyRole() || staffOf(code);
      allow write: if anyRole();
      // What each family may read, kept up to date by the principal's and teachers' phones: school (name,
      // design), c_<class> (the class's published results, monthly checks, homework, notices, routine, fees),
      // s_<student ID> (the child's own record, attendance, notes, comments and receipts)
      match /pv/{doc} {
        allow read: if staffOf(code) || (parentIn(code) && (doc == 'school' || doc == 'c_' + kid().cls || doc == 's_' + kid().sid));
        allow write: if staffOf(code);
      }
      // A family's own answers: leave asked for and homework done (their class teacher reads them)
      match /fromParents/{sid} {
        allow read: if staffOf(code) || (parentIn(code) && kid().sid == sid);
        allow create, update: if parentIn(code) && kid().sid == sid && request.resource.data.keys().hasOnly(['cls', 'roll', 'leave', 'hw'])
          && request.resource.data.cls == kid().cls && request.resource.data.roll == kid().roll
          && request.resource.data.leave is map && request.resource.data.hw is map;
      }
      // Messages between a family and the class teacher; nobody edits or deletes one
      match /messages/{id} {
        allow read: if staffOf(code) || (parentIn(code) && resource.data.sid == kid().sid);
        allow create: if request.resource.data.keys().hasOnly(['sid', 'cls', 'roll', 'from', 'text', 'at'])
          && str(request.resource.data.text, 1, 1000) && request.resource.data.at is int
          && ((staffOf(code) && request.resource.data.from == 'teacher')
            || (parentIn(code) && request.resource.data.from == 'parent' && request.resource.data.sid == kid().sid
              && request.resource.data.cls == kid().cls && request.resource.data.roll == kid().roll));
      }
      // Student photos: one small JPEG per student, given by the principal or a teacher of the school
      match /photos/{studentId} {
        allow read: if staffOf(code) || (parentIn(code) && kid().sid == studentId);
        allow delete: if staffOf(code);
        allow create, update: if staffOf(code) && request.resource.data.keys().hasOnly(['cls', 'roll', 'img', 'at'])
          && request.resource.data.img is string && request.resource.data.img.size() < 120000
          && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      }
      match /state/{part} {
        allow read: if staffOf(code);
        allow write: if principalOf(code)
          || (staffOf(code) && part in ['notices', 'attendance', 'exams', 'standard', 'homework', 'messages']);
      }
    }

    // The activity log: the team reads it and adds to it under their own name; nobody edits it
    match /activity/{id} {
      allow read: if anyRole();
      allow create: if anyRole() && request.resource.data.byId == myEmail() && str(request.resource.data.text, 1, 500);
      allow update: if false;
      allow delete: if hasRole(['owner']);
    }
  }
}
